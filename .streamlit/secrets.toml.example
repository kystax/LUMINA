# Streamlit Secrets Example (.streamlit/secrets.toml)
# In Streamlit Cloud: App Settings -> Secrets

# Option 1: Direct Connection URL (Recommended for Neon, Supabase, Render, Railway, etc.)
DATABASE_URL = "postgresql://username:password@host:5432/lumina_db?sslmode=require"

# Option 2: Individual Parameters
# DB_HOST = "your-db-host.neon.tech"
# DB_PORT = "5432"
# DB_NAME = "lumina_db"
# DB_USER = "postgres"
# DB_PASSWORD = "your_password"
# DB_SSLMODE = "require"
